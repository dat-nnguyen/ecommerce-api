{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Microservices-based Ecommerce Platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint \"**/*.js\"",
    "lint:fix": "eslint \"**/*.js\" --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "test": "npm run test --workspaces --if-present",
    "test:services": "npm run test --workspace=services/* --if-present",
    "test:packages": "npm run test --workspace=packages/* --if-present",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.mjs",
    "docs": "node docs/server.js",
    "clean": "rm -rf node_modules packages/*/node_modules services/*/node_modules"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
